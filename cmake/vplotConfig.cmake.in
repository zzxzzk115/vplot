@PACKAGE_INIT@

# vplot links FreeType and zlib PRIVATELY, but a static library defers its
# dependencies to the consumer's link line, so they have to be findable here.
include(CMakeFindDependencyMacro)
find_dependency(Freetype)
find_dependency(ZLIB)

include("${CMAKE_CURRENT_LIST_DIR}/vplotTargets.cmake")

check_required_components(vplot)
